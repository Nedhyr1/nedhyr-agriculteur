spring.application.name=supervision-service
server.port=8086
# ================= DATABASE =================
spring.datasource.url=jdbc:mysql://127.0.0.1:3306/supervision_db?createDatabaseIfNotExist=true&serverTimezone=UTC&useSSL=false
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver
spring.datasource.username=root
spring.datasource.password=
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect
spring.jpa.properties.hibernate.format_sql=true

spring.rabbitmq.addresses=amqps://qovqmidk:sNpj8rcI2elNxCNuVsDXAxz8h7Zzh-5m@seal.lmq.cloudamqp.com/qovqmidk
# Configuration listener
spring.rabbitmq.listener.type=simple
spring.rabbitmq.listener.simple.acknowledge-mode=auto
spring.rabbitmq.listener.simple.prefetch=10
spring.rabbitmq.listener.simple.concurrency=5

# Reconnexion automatique
spring.rabbitmq.connection-timeout=10000
spring.rabbitmq.template.reply-timeout=10000
eureka.client.register-with-eureka=true
eureka.client.fetch-registry=true
eureka.client.service-url.defaultZone=http://localhost:9095/eureka
management.endpoints.web.exposure.include=health,info,metrics
management.endpoint.health.show-details=always

logging.level.com.agriculture.supervision=INFO
logging.level.org.springframework.amqp=INFO
logging.level.org.springframework.retry=DEBUG

spring.config.import=optional:configserver:http://localhost:8887
